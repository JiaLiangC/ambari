<div class="admin-management-packs container-wrap-table">
  <div class="row">
    <div class="col-md-8"><h2 class="table-title">{{t admin.managementPacks.title}}</h2></div>
    <div class="col-md-4 text-right">
      <button class="btn btn-default" {{action load target="controller"}} {{bindAttr disabled="controller.operationInProgress"}}>
        {{t common.refresh}}
      </button>
    </div>
  </div>

  {{#if controller.loadError}}
    <div class="alert alert-danger">{{controller.loadError}}</div>
  {{/if}}
  {{#if controller.operationError}}
    <div class="alert alert-danger">{{controller.operationError}}</div>
  {{/if}}

  {{#if controller.dataIsLoaded}}
    <h3>{{t admin.managementPacks.registries}}</h3>
    {{#if controller.registries}}
      <table class="table table-hover">
        <thead><tr><th>{{t common.name}}</th><th>{{t common.type}}</th><th>{{t common.url}}</th></tr></thead>
        <tbody>
          {{#each registry in controller.registries}}
            <tr><td>{{registry.name}}</td><td>{{registry.type}}</td><td class="text-break">{{registry.uri}}</td></tr>
          {{/each}}
        </tbody>
      </table>
    {{else}}
      <p>{{t admin.managementPacks.noRegistries}}</p>
    {{/if}}

    <h3>{{t admin.managementPacks.catalog}}</h3>
    {{#if controller.catalog}}
      <table class="table table-hover">
        <thead><tr><th>{{t common.name}}</th><th>{{t common.version}}</th><th>{{t common.description}}</th><th></th></tr></thead>
        <tbody>
          {{#each item in controller.catalog}}
            <tr>
              <td>{{item.displayName}}<div class="text-muted">{{item.name}}</div></td>
              <td>{{item.version}}</td>
              <td>{{item.description}}</td>
              <td class="text-right">
                {{#if controller.canMutate}}
                  <button class="btn btn-primary btn-sm" {{action registerCatalogItem item target="controller"}}>
                    {{t admin.managementPacks.register}}
                  </button>
                {{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{else}}
      <p>{{t admin.managementPacks.noCatalog}}</p>
    {{/if}}

    {{#if controller.canMutate}}
      <div class="well">
        <h4>{{t admin.managementPacks.registerUri}}</h4>
        <div class="input-group">
          {{view Ember.TextField valueBinding="controller.directUri" class="form-control" placeholder="URI"}}
          <span class="input-group-btn">
            <button class="btn btn-success" {{action registerUri target="controller"}} {{bindAttr disabled="controller.operationInProgress"}}>
              {{t admin.managementPacks.register}}
            </button>
          </span>
        </div>
      </div>
    {{/if}}

    <h3>{{t admin.managementPacks.registered}}</h3>
    {{#if controller.mpacks}}
      <table class="table table-hover">
        <thead><tr><th>{{t common.name}}</th><th>{{t common.version}}</th><th>{{t common.url}}</th><th></th></tr></thead>
        <tbody>
          {{#each mpack in controller.mpacks}}
            <tr>
              <td>{{mpack.displayName}}<div class="text-muted">{{mpack.name}}</div></td>
              <td>{{mpack.version}}</td>
              <td class="text-break">{{mpack.uri}}</td>
              <td class="text-right">
                {{#if controller.canMutate}}
                  <button class="btn btn-danger btn-sm" {{action removeMpack mpack target="controller"}}>
                    {{t common.remove}}
                  </button>
                {{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{else}}
      <p>{{t admin.managementPacks.noRegistered}}</p>
    {{/if}}
  {{else}}
    {{view App.SpinnerView}}
  {{/if}}
</div>
