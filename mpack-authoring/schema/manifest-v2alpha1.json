{
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "mpack.ambari.apache.org/v2alpha1"
    },
    "kind": {
      "const": "Mpack"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "compatibility": {
          "type": "object",
          "properties": {
            "ambari": {
              "type": "string",
              "minLength": 1
            },
            "agentSdk": {
              "type": "string",
              "minLength": 1
            },
            "dependencyProtocol": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
              },
              "source": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "file",
                      "url"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uri": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
              },
              "interface": {
                "type": "string",
                "minLength": 1
              },
              "versionRange": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "interface"
            ],
            "additionalProperties": false
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "configurations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
                    },
                    "schema": {
                      "type": "string",
                      "minLength": 1
                    },
                    "template": {
                      "type": "string",
                      "minLength": 1
                    },
                    "changeEffect": {
                      "enum": [
                        "none",
                        "reload",
                        "restart",
                        "migration"
                      ]
                    },
                    "defaults": {
                      "type": "object"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "name",
                    "schema"
                  ],
                  "additionalProperties": false
                }
              },
              "components": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
                    },
                    "category": {
                      "enum": [
                        "MASTER",
                        "SLAVE",
                        "CLIENT"
                      ]
                    },
                    "role": {
                      "enum": [
                        "service",
                        "client"
                      ]
                    },
                    "cardinality": {
                      "type": "object",
                      "properties": {
                        "min": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "max": {
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "const": "*"
                            }
                          ]
                        }
                      },
                      "required": [
                        "min",
                        "max"
                      ],
                      "additionalProperties": false
                    },
                    "profiles": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
                          },
                          "adapter": {
                            "type": "string",
                            "minLength": 1
                          },
                          "capabilities": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            },
                            "minItems": 1,
                            "uniqueItems": true
                          },
                          "upgradePolicy": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "fromPackageDigests": {
                                "type": "array",
                                "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                                "minItems": 1,
                                "maxItems": 32,
                                "uniqueItems": true
                              },
                              "configuration": {"const": "compatible"},
                              "data": {"const": "unchanged"}
                            },
                            "required": ["fromPackageDigests", "configuration", "data"]
                          },
                          "resources": {
                            "type": "object",
                            "properties": {
                              "executableArtifacts": {
                                "type": "array", "uniqueItems": true,
                                "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"}
                              },
                              "reloadSignal": {
                                "enum": ["HUP", "USR1", "USR2"]
                              },
                              "packages": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "users": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "name": {
                                      "type": "string",
                                      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
                                    },
                                    "group": {
                                      "type": "string",
                                      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
                                    }
                                  },
                                  "required": [
                                    "name"
                                  ],
                                  "additionalProperties": false
                                }
                              },
                              "directories": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "path": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "owner": {
                                      "type": "string",
                                      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
                                    },
                                    "mode": {
                                      "type": "string",
                                      "pattern": "^0[0-7]{3}$"
                                    },
                                    "persistent": {
                                      "type": "boolean"
                                    },
                                    "retention": {
                                      "enum": [
                                        "retain"
                                      ]
                                    }
                                  },
                                  "required": [
                                    "path",
                                    "owner"
                                  ],
                                  "additionalProperties": false
                                }
                              },
                              "ports": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "name": {
                                      "type": "string",
                                      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
                                    },
                                    "configRef": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "protocol": {
                                      "enum": [
                                        "tcp",
                                        "udp"
                                      ]
                                    }
                                  },
                                  "required": [
                                    "name",
                                    "configRef"
                                  ],
                                  "additionalProperties": false
                                }
                              },
                              "command": {
                                "type": "object",
                                "properties": {
                                  "program": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "artifactRef": {
                                    "type": "string",
                                    "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
                                  },
                                  "arguments": {
                                    "type": "array",
                                    "items": {
                                      "oneOf": [
                                        {
                                          "type": "string",
                                          "minLength": 1
                                        },
                                        {
                                          "type": "object",
                                          "properties": {
                                            "artifactRef": {
                                              "type": "string",
                                              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
                                            }
                                          },
                                          "required": [
                                            "artifactRef"
                                          ],
                                          "additionalProperties": false
                                        },
                                        {
                                          "type": "object",
                                          "properties": {
                                            "configRef": {
                                              "type": "string",
                                              "minLength": 1
                                            }
                                          },
                                          "required": [
                                            "configRef"
                                          ],
                                          "additionalProperties": false
                                        },
                                        {
                                          "type": "object",
                                          "properties": {
                                            "secretRef": {
                                              "type": "string",
                                              "minLength": 1
                                            }
                                          },
                                          "required": [
                                            "secretRef"
                                          ],
                                          "additionalProperties": false
                                        },
                                        {
                                          "type": "object",
                                          "properties": {
                                            "configurationRef": {
                                              "type": "string",
                                              "minLength": 1
                                            }
                                          },
                                          "required": [
                                            "configurationRef"
                                          ],
                                          "additionalProperties": false
                                        },
                                        {
                                          "type": "object",
                                          "properties": {
                                            "directoryRef": {
                                              "type": "string",
                                              "minLength": 1
                                            }
                                          },
                                          "required": [
                                            "directoryRef"
                                          ],
                                          "additionalProperties": false
                                        }
                                      ]
                                    }
                                  },
                                  "environment": {
                                    "type": "object",
                                    "additionalProperties": {
                                      "oneOf": [
                                        {
                                          "type": "string",
                                          "minLength": 1
                                        },
                                        {
                                          "type": "object",
                                          "properties": {
                                            "artifactRef": {
                                              "type": "string",
                                              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
                                            }
                                          },
                                          "required": [
                                            "artifactRef"
                                          ],
                                          "additionalProperties": false
                                        },
                                        {
                                          "type": "object",
                                          "properties": {
                                            "configRef": {
                                              "type": "string",
                                              "minLength": 1
                                            }
                                          },
                                          "required": [
                                            "configRef"
                                          ],
                                          "additionalProperties": false
                                        },
                                        {
                                          "type": "object",
                                          "properties": {
                                            "secretRef": {
                                              "type": "string",
                                              "minLength": 1
                                            }
                                          },
                                          "required": [
                                            "secretRef"
                                          ],
                                          "additionalProperties": false
                                        }
                                      ]
                                    }
                                  }
                                },
                                "required": [],
                                "additionalProperties": false
                              },
                              "unit": {
                                "type": "object",
                                "properties": {
                                  "user": {
                                    "type": "string",
                                    "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
                                  },
                                  "group": {
                                    "type": "string",
                                    "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
                                  },
                                  "workingDirectory": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "required": [
                                  "user"
                                ],
                                "additionalProperties": false
                              },
                              "engine": {"enum": ["docker", "podman"]},
                              "runAsUser": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
                              "runAsUserId": {"type": "integer", "minimum": 1, "maximum": 2147483647},
                              "connectionRef": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
                              "mounts": {
                                "type": "array", "maxItems": 32,
                                "items": {
                                  "type": "object", "additionalProperties": false,
                                  "required": ["directoryRef", "containerPath"],
                                  "properties": {
                                    "directoryRef": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
                                    "containerPath": {"type": "string", "pattern": "^/[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$", "maxLength": 256}
                                  }
                                }
                              },
                              "limits": {
                                "type": "object", "additionalProperties": false,
                                "properties": {
                                  "memoryMiB": {"type": "integer", "minimum": 64, "maximum": 65536},
                                  "cpus": {"type": "integer", "minimum": 1, "maximum": 64},
                                  "pids": {"type": "integer", "minimum": 16, "maximum": 4096}
                                }
                              },
                              "image": {
                                "type": "string",
                                "minLength": 1
                              },
                              "namespace": {
                                "type": "string",
                                "minLength": 1
                              },
                              "name": {
                                "type": "string",
                                "minLength": 1
                              },
                              "replicas": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "artifactRef": {
                                "type": "string",
                                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
                              },
                              "endpoint": {
                                "type": "object",
                                "properties": {
                                  "configRef": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "required": [
                                  "configRef"
                                ],
                                "additionalProperties": false
                              }
                            },
                            "required": [],
                            "additionalProperties": false
                          },
                          "health": {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "enum": [
                                  "http",
                                  "tcp",
                                  "process"
                                ]
                              },
                              "portRef": {
                                "type": "string",
                                "minLength": 1
                              },
                              "path": {
                                "type": "string",
                                "minLength": 1
                              },
                              "timeoutSeconds": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 300
                              }
                            },
                            "required": [
                              "kind"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "id",
                          "adapter",
                          "capabilities"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1
                    },
                    "softwareVersion": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,127}$"
                    }
                  },
                  "required": [
                    "name",
                    "profiles"
                  ],
                  "additionalProperties": false
                }
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "slot": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
                    },
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
                    },
                    "interface": {
                      "type": "string",
                      "minLength": 1
                    },
                    "versionRange": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "interface"
                  ],
                  "additionalProperties": false
                }
              },
              "provides": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "slot": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
                    },
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
                    },
                    "interface": {
                      "type": "string",
                      "minLength": 1
                    },
                    "versionRange": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "interface"
                  ],
                  "additionalProperties": false
                }
              },
              "operations": {
                "type": "array",
                "maxItems": 0
              },
              "observability": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "logs": {
                    "type": "object", "maxProperties": 64,
                    "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
                    "additionalProperties": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$"}
                  },
                  "metrics": {
                    "type": "object", "maxProperties": 64,
                    "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
                    "additionalProperties": {
                      "type": "object", "additionalProperties": false,
                      "required": ["portRef", "path", "fields"],
                      "properties": {
                        "portRef": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*[.][A-Za-z][A-Za-z0-9_.-]*$"},
                        "protocol": {"enum": ["http", "https"]},
                        "path": {"type": "string", "pattern": "^/[A-Za-z0-9_/-]+$", "maxLength": 256},
                        "fields": {
                          "type": "object", "minProperties": 1, "maxProperties": 64,
                          "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"},
                          "additionalProperties": {
                            "type": "array", "minItems": 1, "maxItems": 8,
                            "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"}
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "name",
              "components"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "services"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambari.apache.org/mpack/v2alpha1/manifest.schema.json",
  "title": "Ambari Mpack v2alpha1 authoring (not a deployment API)"
}
